    "principles": [
      {
        "title": "Combinatorial evolution",
        "description": "Innovation comes from new combinations of skills, firms, technologies and facilities across hubs"
      },
      {
        "title": "Emergence",
        "description": "Create conditions for hubs to experiment, specialise and develop activities without prescribing one model everywhere"
      },
      {
        "title": "Increasing returns",
        "description": "Turn each successful collaboration into contacts, shared knowledge and opportunities for others"
      },
      {
        "title": "Adaptation",
        "description": "Use small experiments, measure results, stop failures and scale what works"
      },
      {
        "title": "Path dependence",
        "description": "Build shared infrastructure and open networks while avoiding isolated systems and rigid structures"
      },
      {
        "title": "Economic formation",
        "description": "Assess new firms, contracts, products and partnerships alongside workspace occupancy"
      }
    ],
    "actions": [
      {
        "title": "Know the network",
        "description": "Map skills, businesses, equipment and expertise across hubs"
      },
      {
        "title": "Make introductions",
        "description": "Help firms find customers, suppliers, collaborators and expertise in other hubs"
      },
      {
        "title": "Solve problems together",
        "description": "Enable hubs to share challenges and jointly develop solutions"
      },
      {
        "title": "Fund experiments",
        "description": "Support cross-hub projects with small grants, learn and scale successes"
      },
      {
        "title": "Reward collaboration",
        "description": "Track contracts, businesses, partnerships and jobs as well as occupancy"
      },
      {
        "title": "Share what works",
        "description": "Make successful practices easy for other hubs to copy and improve"
      }
